# Daftar Environment Variables untuk Vercel (Project → Settings → Environment Variables).
# Salin juga menjadi .env.vercel di laptop untuk menjalankan migrasi:
#   php artisan migrate --force --env=vercel

APP_NAME="Catatan Keuangan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-proyek.vercel.app
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Database MySQL gratis: TiDB Cloud Starter (https://tidbcloud.com)
DB_CONNECTION=mysql
DB_HOST=gateway01.xxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=catatan_keuangan
DB_USERNAME=xxxxxxxx.root
DB_PASSWORD=
# Di Vercel otomatis memakai /etc/pki/tls/certs/ca-bundle.crt (tidak perlu diisi).
# Di laptop (Laragon), aktifkan baris berikut:
# MYSQL_ATTR_SSL_CA=C:/laragon/etc/ssl/cacert.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Penyimpanan foto struk gratis: Supabase Storage (S3 compatible)
RECEIPT_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=receipts
AWS_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
AWS_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/receipts
AWS_USE_PATH_STYLE_ENDPOINT=true

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nama-proyek.vercel.app/auth/google/callback

# Email (opsional, untuk lupa password). Contoh Gmail + App Password.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
